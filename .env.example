# Copy this file to .env.local and fill in values from
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only key used by /api/extraction. Never prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=your-openai-api-key

# Server-only Supabase Storage S3 configuration for product photos.
# Copy the endpoint, region and S3 credentials from Storage's S3 configuration.
S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
S3_BUCKET_NAME=your-s3-bucket-name
S3_BUCKET_REGION=your-s3-bucket-region
S3_ACCESS_KEY_ID=your-s3-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-secret-access-key

# Set false to pause new cross-sell and value comparisons.
STYLIST_COMMERCE_ENABLED=true
# Set false to roll back task replacement/recovery behavior while keeping the request contract compatible.
STYLIST_TASK_RECOVERY_ENABLED=true
# Optional server diagnostics contain stages, issue codes and field names, never raw messages or signed URLs.
STYLIST_DIAGNOSTICS_ENABLED=false
# Optional first-party stylist telemetry. Apply the migration before enabling it.
STYLIST_ANALYTICS_ENABLED=false
# Server-only; never use a NEXT_PUBLIC_ prefix or expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
